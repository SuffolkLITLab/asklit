# Copy to .env.hosted for a local-only setup with no SSO registration.
COMPOSE_PROFILES=
ASKLIT_DEV_MODE=true
ASKLIT_DEV_USERNAME=dev@asklit.local
ASKLIT_DEV_PASSWORD=asklit
ASKLIT_SECRET_KEY=asklit-local-development-secret-only
ASKLIT_BASE_URL=http://localhost:8000
ASKLIT_CORS_ORIGINS=http://localhost:3000
# Native Python path. For Docker Compose change to sqlite:////var/lib/asklit/hosted.sqlite3
ASKLIT_DATABASE_URL=sqlite:///hosted-data/hosted.sqlite3
OPENAI_API_KEY=
ASKLIT_MODELS_JSON={"tiny":{"provider":"openai","model":"gpt-4.1-nano","api_key_env":"OPENAI_API_KEY","max_tokens":300}}
