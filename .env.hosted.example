# Compose database selection: postgres starts the bundled PostgreSQL service.
# Set empty for an external PostgreSQL/Supabase URL or development SQLite.
COMPOSE_PROFILES=postgres
ASKLIT_DEV_MODE=false
# Fixed credentials are available only with ASKLIT_DEV_MODE=true:
# ASKLIT_DEV_USERNAME=dev@asklit.local
# ASKLIT_DEV_PASSWORD=asklit
# Generate each secret independently: python -c 'import secrets; print(secrets.token_urlsafe(48))'
POSTGRES_PASSWORD=replace-with-url-safe-random-value
ASKLIT_SECRET_KEY=replace-with-at-least-32-random-characters
ASKLIT_BASE_URL=http://localhost:8000
ASKLIT_CORS_ORIGINS=http://localhost:3000,https://courtformsonline.org,https://www.courtformsonline.org
# Required for running outside Compose:
# ASKLIT_DATABASE_URL=postgresql+psycopg://asklit:PASSWORD@localhost:5432/asklit
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=organizations
OPENAI_API_KEY=
ASKLIT_MODELS_JSON={"default":{"provider":"openai","model":"gpt-5.4-mini","api_key_env":"OPENAI_API_KEY","max_tokens":1500}}
ASKLIT_DAILY_CALLS=500
ASKLIT_GLOBAL_DAILY_CALLS=5000
ASKLIT_PUBLIC_DAILY_CALLS=5000
ASKLIT_RETENTION_DAYS=7
ASKLIT_JOB_TIMEOUT_SECONDS=1800
# With a host reverse proxy and Docker port forwarding, set this to the Docker
# network gateway address seen by the container (inspect with docker network inspect).
# Do not use '*' or trust arbitrary internet addresses.
# FORWARDED_ALLOW_IPS=172.18.0.1

# Supabase alternative (use compose.supabase.yml instead of compose.hosted.yml):
# ASKLIT_DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
# ASKLIT_STORAGE_BACKEND=supabase
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_STORAGE_BUCKET=asklit-private
# SUPABASE_SERVICE_ROLE_KEY=server-only-legacy-service-role-key

# Maximum answer + rubric judge calls in one evaluation matrix.
ASKLIT_EVALUATION_MAX_CALLS=240

# Optional paid speech. Browser speech is available without these settings.
# Use models supported by your compatible /audio/transcriptions and /audio/speech provider.
ASKLIT_SPEECH_BASE_URL=https://api.openai.com/v1
ASKLIT_SPEECH_API_KEY=
ASKLIT_SPEECH_KEY_HEADER=Authorization
ASKLIT_SPEECH_STT_MODEL=
ASKLIT_SPEECH_TTS_MODEL=
ASKLIT_SPEECH_VOICE=alloy
ASKLIT_SPEECH_DAILY_CALLS=1000
# Or use AWS (Polly + Transcribe streaming) with the service's existing AWS credentials. Metered in USD
# against ASKLIT_MONTHLY_AI_BUDGET_USD; no API key or model names needed.
# ASKLIT_SPEECH_PROVIDER=aws
# ASKLIT_SPEECH_REGION=us-east-1
# ASKLIT_SPEECH_LANGUAGE=en-US
# ASKLIT_SPEECH_VOICE=Joanna
# ASKLIT_SPEECH_AWS_ENGINE=neural
# ASKLIT_SPEECH_TTS_USD_PER_MILLION_CHARS=16.0
# ASKLIT_SPEECH_STT_USD_PER_MINUTE=0.024

# Optional trial: bypass hosting approval until this exclusive UTC date.
# Keep ASKLIT_REQUIRE_AUTHOR_APPROVAL=true to resume approval automatically.
# ASKLIT_REQUIRE_AUTHOR_APPROVAL=true
# ASKLIT_OPEN_REGISTRATION_UNTIL=2027-01-01
