# AskLit secrets for local development and Streamlit Community Cloud.
#
# For Streamlit Community Cloud, paste this file's contents into the app's
# Settings > Secrets panel instead of committing a real secrets.toml file.

# OPENAI_API_KEY = "your-key-here"
# OPENAI_BASE_URL = "https://your-custom-endpoint.com/v1"
# ANTHROPIC_API_KEY = "your-key-here"
# APP_SECRET_KEY = "generate-a-random-string"
# ADMIN_ROUTE = "my-secret-admin-access"
# ADMIN_PASSWORD_HASH = "generate-a-hash"
# SHARED_PASSWORD_HASH = "generate-a-hash"

# Optional setting overrides. Dotted keys must be quoted in TOML.
# "app.title" = "AskLit"
# "app.access_mode" = "public"
# "app.conversation_starters" = ["What can you help me with?", "Summarize the knowledge base."]
# "model.provider" = "openai"
# GitHub Scaffolder Secrets (Optional)
# GITHUB_CLIENT_ID = "your-github-client-id"
# GITHUB_CLIENT_SECRET = "your-github-client-secret"
# GITHUB_REDIRECT_URI = "https://your-app.streamlit.app"
