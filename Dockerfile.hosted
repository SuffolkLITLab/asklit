FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    ASKLIT_STORAGE=/var/lib/asklit HF_HOME=/var/cache/asklit
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
COPY requirements.txt requirements-hosted.txt ./
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir -r requirements-hosted.txt
COPY asklit ./asklit
COPY runtime ./runtime
COPY admin ./admin
COPY config ./config
COPY chat_ui.py login_ui.py alembic.ini ./
RUN useradd --uid 10001 --create-home asklit && \
    mkdir -p /var/lib/asklit /var/cache/asklit /app/data && \
    chown -R asklit:asklit /var/lib/asklit /var/cache/asklit /app/data
USER asklit
EXPOSE 8000
CMD ["uvicorn", "asklit.hosted.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
